FERNET_KEY=

# UID пользователя, от которого работает Airflow внутри контейнеров.
AIRFLOW_UID=50000
AIRFLOW_GID=0

# Учётка веб-интерфейса Airflow (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# PostgreSQL: метаданные Airflow + измерения DWH.
# Должны совпадать с кредами в clickhouse/init/init.sql — оттуда
# словари ClickHouse ходят в Postgres за измерениями.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ClickHouse: факты и витрины
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin

# MinIO: S3-совместимое хранилище
MINIO_USER=s3admin
MINIO_PASSWORD=s3admin123

# Telegram-алерты о статусе прогона.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
